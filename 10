df<-data.frame(hours=c(1,2,4,5,5,6,6,7,8,10,11,11,12,12,14),score = 
c(64,66,76,75,74,81,83,82,80,88,84,82,91,93,89))
head(df)
attach(df)
scatter.smooth(hours,score,main="hours studied vs exam score")
boxplot(score)
model <- lm(score~hours)
summary(model)
lm(score~hours)
res<-resid(model)
plot(fitted(model),res)
abline(0,0)
qqnorm(res)
qqline(res)
